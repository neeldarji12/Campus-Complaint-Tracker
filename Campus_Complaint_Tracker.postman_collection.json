          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/complaints",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints"]
            },
            "description": "Retrieves all registered complaints sorted newest first."
          }
        },
        {
          "name": "Get Complaint By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/complaints/{{complaintId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints", "{{complaintId}}"]
            },
            "description": "Fetch a specific complaint using its MongoDB ObjectId."
          }
        },
        {
          "name": "Update Complaint Details (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Broken Projector in Lecture Hall 3 (Bulb Replaced)\",\n  \"description\": \"Technician replaced the lamp, need to verify resolution.\",\n  \"priority\": \"Medium\",\n  \"location\": \"Lecture Hall 3, Block A (Near Podium)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/complaints/{{complaintId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints", "{{complaintId}}"]
            },
            "description": "Updates editable fields of an existing complaint."
          }
        },
        {
          "name": "Update Complaint Status Only (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/complaints/{{complaintId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints", "{{complaintId}}", "status"]
            },
            "description": "Updates only the status field. Valid values: Open, In Progress, Resolved, Rejected."
          }
        },
        {
          "name": "Mark Complaint Resolved (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Resolved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/complaints/{{complaintId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints", "{{complaintId}}", "status"]
            }
          }
        },
        {
          "name": "Delete Complaint",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/complaints/{{complaintId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints", "{{complaintId}}"]
            },
            "description": "Deletes the complaint by ID."
          }
        }
      ]
    },
    {
