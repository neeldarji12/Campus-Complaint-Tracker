{
  "info": {
    "_postman_id": "c1f7b8a2-9d3e-4b28-a570-981f3d32ce71",
    "name": "Campus Complaint Tracker API",
    "description": "Complete REST API collection for Campus Complaint Tracker built with Node.js, Express, and MongoDB/Mongoose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "complaintId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Welcome Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Checks server status and displays available API endpoints."
      }
    },
    {
      "name": "2. Complaints CRUD",
      "item": [
        {
          "name": "Create Complaint 1 - Infrastructure (High)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('complaintId', jsonData.data._id);",
                  "    console.log('Saved complaintId:', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentName\": \"Aarav Patel\",\n  \"email\": \"aarav.patel@campus.edu\",\n  \"title\": \"Broken Projector in Lecture Hall 3\",\n  \"description\": \"The ceiling projector is flickering constantly and shuts down after 10 minutes of usage.\",\n  \"category\": \"Infrastructure\",\n  \"priority\": \"High\",\n  \"location\": \"Lecture Hall 3, Block A\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/complaints",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints"]
            },
            "description": "Creates a new complaint. Status will default to 'Open'. Saves complaint ID automatically for subsequent tests."
          }
        },
        {
          "name": "Create Complaint 2 - IT (Medium)",
          "request": {
            "method": "POST",
            "header": [
